# AIGateway environment variables
#
# A key present in this file wins. Missing keys fall back to config/defaults.py.
# Never commit real credentials.

AIGATEWAY_APP_ENV=development
AIGATEWAY_HOST=0.0.0.0
AIGATEWAY_PORT=8000
AIGATEWAY_LOG_LEVEL=INFO
AIGATEWAY_LOG_DIR=logs

AIGATEWAY_DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/aigateway?charset=utf8mb4
AIGATEWAY_DB_ECHO=false
AIGATEWAY_DB_POOL_SIZE=10
AIGATEWAY_DB_MAX_OVERFLOW=20
AIGATEWAY_DB_POOL_RECYCLE_SECONDS=1800

AIGATEWAY_UPSTREAM_TIMEOUT_SECONDS=600
AIGATEWAY_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
AIGATEWAY_UPSTREAM_MAX_CONNECTIONS=200
AIGATEWAY_UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=50
AIGATEWAY_UPSTREAM_MAX_ATTEMPTS=3
AIGATEWAY_UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.25

AIGATEWAY_KEY_CANDIDATE_LIMIT=3
AIGATEWAY_DEFAULT_GROUP_TYPE=API
AIGATEWAY_REQUEST_ID_HEADER=X-Request-ID

AIGATEWAY_MODEL_DISABLE_ENABLED=false
AIGATEWAY_MODEL_DISABLE_LIST=

AIGATEWAY_TIME_TRACKING_ENABLED=false

AIGATEWAY_REDIS_ENABLED=false
AIGATEWAY_REDIS_HOST=127.0.0.1
AIGATEWAY_REDIS_PORT=6379
AIGATEWAY_REDIS_DB=0
AIGATEWAY_REDIS_PASSWORD=
AIGATEWAY_REDIS_DEFAULT_TTL_SECONDS=3600
AIGATEWAY_REDIS_SOCKET_TIMEOUT_SECONDS=2

AIGATEWAY_AUTH_L1_CACHE_TTL_SECONDS=300
AIGATEWAY_AUTH_CACHE_TTL_SECONDS=3600