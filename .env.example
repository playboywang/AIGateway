# AIGateway environment template
#
# 使用方式：
#   1. 复制本文件为 .env
#   2. 保留需要覆盖的配置，删除或注释掉需要由 config/ 提供默认值的配置
#
# 配置优先级：
#   .env 中存在的变量 > config/ 中的默认值
#
# 注意：不要提交真实的密钥、数据库密码或生产环境凭据。

# ------------------------------
# Application
# ------------------------------
AIGATEWAY_ENV=development
AIGATEWAY_DEBUG=false
AIGATEWAY_HOST=0.0.0.0
AIGATEWAY_PORT=8000
AIGATEWAY_WORKERS=1
AIGATEWAY_TIMEZONE=Asia/Shanghai

# ------------------------------
# Database
# ------------------------------
AIGATEWAY_DATABASE_URL=mysql+asyncmy://aigateway:change-me@127.0.0.1:3306/aigateway?charset=utf8mb4
AIGATEWAY_DB_POOL_SIZE=10
AIGATEWAY_DB_MAX_OVERFLOW=20
AIGATEWAY_DB_POOL_RECYCLE_SECONDS=1800
AIGATEWAY_DB_ECHO=false

# ------------------------------
# Redis
# ------------------------------
AIGATEWAY_REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------
# Security
# ------------------------------
AIGATEWAY_SECRET_KEY=change-me
AIGATEWAY_ENCRYPTION_KEY=change-me
AIGATEWAY_API_KEY_PEPPER=change-me

# ------------------------------
# HTTP client and request limits
# ------------------------------
AIGATEWAY_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
AIGATEWAY_UPSTREAM_READ_TIMEOUT_SECONDS=600
AIGATEWAY_UPSTREAM_WRITE_TIMEOUT_SECONDS=60
AIGATEWAY_HTTP_MAX_CONNECTIONS=200
AIGATEWAY_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
AIGATEWAY_MAX_CONCURRENT_REQUESTS=1000

# ------------------------------
# CORS and trusted hosts
# Multiple values are comma-separated.
# ------------------------------
AIGATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AIGATEWAY_TRUSTED_HOSTS=localhost,127.0.0.1

# ------------------------------
# Logging and observability
# ------------------------------
AIGATEWAY_LOG_LEVEL=INFO
AIGATEWAY_LOG_JSON=true
AIGATEWAY_METRICS_ENABLED=true
AIGATEWAY_METRICS_PATH=/metrics
AIGATEWAY_OTEL_ENABLED=false
AIGATEWAY_OTEL_ENDPOINT=
